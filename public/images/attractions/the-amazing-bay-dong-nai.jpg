<script type="text/javascript">
    $(document).ready(function() {
        $('body').removeClass('home');
        var window_width = $(window).width();
        $("#back-top").hide();
        $(window).scroll(function () {
            if ($(this).scrollTop() > 400) {
                $('#back-top').fadeIn();
                
            } else {
                $('#back-top').fadeOut();
                                $('body').removeClass('home');
                            }
        });
        $('#back-top').click(function () {
            $('body,html').animate({
                scrollTop: 0
            }, 500);
            return false;
        });
    });

</script>
